# =============================================================================
# VANHSYA TRAVELS — Environment Variables
# -----------------------------------------------------------------------------
# VERCEL: Add these in Project → Settings → Environment Variables (do NOT commit
# a real .env). The serverless API (api/index.ts) reads them at runtime.
# Required for the AI Concierge / Translator ("Vanhsya Travels X") & AI Planner:
#   GEMINI_API_KEY   <-- set this in Vercel or those features return 503.
# The SQLite DB auto-falls back to /tmp + in-memory on Vercel (read-only FS).
# =============================================================================

# Server-side Gemini API key for AI Planner & Live Concierge
GEMINI_API_KEY=

# Optional administrator passcode for /admin dashboard (if unset, first visitor sets up admin passcode once)
ADMIN_PASSCODE=

# Optional HMAC signing secret for admin & user session tokens (auto-generated in memory if omitted)
SESSION_SECRET=

# Public base URL for Stripe Checkout redirects & QR share links (optional, defaults to request origin)
APP_BASE_URL=

# Optional Stripe Checkout & Webhook secrets (if unset, bookings record 'awaiting_merchant_config' honestly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Real Travel Provider API Credentials (if unset, search endpoints return awaiting_credentials honestly)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
HOTELBEDS_API_KEY=
BUS_PROVIDER_API_KEY=

# Optional VYNO Web3 Smart Contract & Compliance Gate (keep claims disabled until reviewed)
VYNO_CONTRACT_ADDRESS=
VYNO_CHAIN_ID=
VYNO_COMPLIANCE_APPROVED=false
